{
  "source": {
    "include": ["src"],
    "includePattern": "\\.js$"
  },
  "opts": {
    "destination": "../docs/site/api/javascript",
    "recurse": true,
    "readme": "README.md"
  },
  "plugins": ["plugins/markdown"],
  "templates": {
    "cleverLinks": true,
    "monospaceLinks": false
  }
}
