{
  "name": "lino-rest-api",
  "version": "0.1.0",
  "description": "REST API framework and client using Links Notation (LINO) instead of JSON",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "example": "node examples/basic_usage.js",
    "docs": "jsdoc -c jsdoc.json"
  },
  "keywords": [
    "rest-api",
    "links-notation",
    "lino",
    "express",
    "bun",
    "content-negotiation",
    "problem-details",
    "openapi"
  ],
  "author": "Link Foundation",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/link-foundation/lino-rest-api.git"
  },
  "dependencies": {
    "express": "^5.2.1",
    "links-notation": "^0.20.0",
    "lino-objects-codec": "^0.8.0"
  },
  "devDependencies": {
    "jsdoc": "^4.0.5",
    "test-anywhere": "^0.9.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
